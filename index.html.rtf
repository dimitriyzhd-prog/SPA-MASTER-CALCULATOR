        <!-- \'ca\'d0\'d3\'c3\'ce\'c2\'c0\'df \'c4\'c8\'c0\'c3\'d0\'c0\'cc\'cc\'c0 -->\par
        <div class="chart-box">\par
            <div class="pie-chart" id="distribution-chart"></div>\par
            <div class="chart-legend">\par
                <div class="legend-item"><span class="legend-color" style="background: var(--accent-red)"></span>\'cd\'e0\'eb\'ee\'e3</div>\par
                <div class="legend-item"><span class="legend-color" style="background: var(--brand-gold)"></span>\'cc\'e0\'f2\'e5\'f0\'e8\'e0\'eb\'fb</div>\par
                <div class="legend-item"><span class="legend-color" style="background: var(--text-white)"></span>\'c0\'f0\'e5\'ed\'e4\'e0</div>\par
                <div class="legend-item"><span class="legend-color" style="background: var(--slate-gray)"></span>\'c8\'ed\'f1\'f2\'f0\'f3\'ec\'e5\'ed\'f2</div>\par
            </div>\par
        </div>\par
    </div>\par
\par
    <!-- \'c3\'cb\'c0\'c2\'cd\'db\'c9 \'c8\'d2\'ce\'c3\'ce\'c2\'db\'c9 \'c4\'c0\'d8\'c1\'ce\'d0\'c4 -->\par
    <div class="dashboard-grid">\par
        <div class="dash-card">\par
            <div class="dash-label">\u9878?\u-497? \'cc\'e8\'ed\'e8\'ec\'e0\'eb\'fc\'ed\'fb\'e9 \'ef\'f0\'e0\'e9\'f1 (\'cf\'ee\'ea\'f0\'fb\'e2\'e0\'e5\'f2 \'f0\'e0\'f1\'f5\'ee\'e4\'fb + \'c6\'e5\'eb\'e0\'e5\'ec\'fb\'e9 \'f7\'e0\'f1)</div>\par
            <div class="dash-val" id="total-minimum">0.00 BYN</div>\par
        </div>\par
        <div class="dash-card highlight">\par
            <div class="dash-label">\u-10179?\u-9035? \'c2\'e0\'f8\'e0 \'f3\'f1\'f2\'e0\'ed\'ee\'e2\'eb\'e5\'ed\'ed\'e0\'ff \'f6\'e5\'ed\'e0</div>\par
            <div style="max-width: 180px; margin: 0 auto;">\par
                <input type="number" id="custom-price" value="100" step="1" oninput="calculateAll()" style="text-align: center; font-weight: 700; font-size: 24px; color: var(--brand-gold); border-color: rgba(212,175,55,0.4);">\par
            </div>\par
        </div>\par
        <div class="dash-card success">\par
            <div class="dash-label">\u9884?\u-497? \'d7\'e8\'f1\'f2\'fb\'e9 \'e4\'ee\'f5\'ee\'e4 \'f1 \'ee\'e4\'ed\'ee\'e9 \'f3\'f1\'eb\'f3\'e3\'e8</div>\par
            <div class="dash-val" id="net-profit" style="color: var(--text-white);">0.00 BYN</div>\par
        </div>\par
    </div>\par
</div>\par
<script>\par
    const initialMaterials = [\par
        \{ name: "\'ca\'f0\'e0\'f1\'e8\'f2\'e5\'eb\'fc SPA CREAM COLOR", used: 30, price: 21.90, totalWeight: 100 \},\par
        \{ name: "\'ce\'ea\'e8\'f1\'eb\'e8\'f2\'e5\'eb\'fc SPA MASTER", used: 45, price: 31.90, totalWeight: 1000 \},\par
        \{ name: "\'d8\'e0\'ec\'ef\'f3\'ed\'fc Post Color SPA MASTER", used: 15, price: 46.52, totalWeight: 1000 \},\par
        \{ name: "\'c8\'ed\'f2\'e5\'ed\'f1\'e8\'e2\'ed\'e0\'ff \'ec\'e0\'f1\'ea\'e0 SPA MASTER", used: 30, price: 57.90, totalWeight: 1000 \},\par
        \{ name: "\'cb\'e0\'ec\'e8\'ed\'e8\'f0\'f3\'fe\'f9\'e8\'e9 \'c1\'e0\'eb\'fc\'e7\'e0\'ec SPA MASTER", used: 10, price: 59.36, totalWeight: 1000 \},\par
        \{ name: "\'ce\'e1\'e5\'f1\'f6\'e2\'e5\'f7\'e8\'e2\'e0\'fe\'f9\'e0\'ff \'ef\'f3\'e4\'f0\'e0  SPA MASTER", used: 1, price: 64.90, totalWeight: 500 \},\par
        \{ name: "\'cc\'e8\'f6\'e5\'eb\'eb\'ff\'f0\'ed\'fb\'e9 \'f8\'e0\'ec\'ef\'f3\'ed\'fc SPA MASTER", used: 1, price: 53.14, totalWeight: 1000 \}\par
    ];\par
\par
    const initialDisposables = [\par
        \{ name: "\'d4\'ee\'eb\'fc\'e3\'e0, \'ec\'e5\'f2\'f0\'ee\'e2", used: 1, price: 0.20 \},\par
        \{ name: "\'c2\'ee\'f0\'ee\'f2\'ed\'e8\'f7\'ee\'ea, \'f8\'f2", used: 2, price: 0.05 \},\par
        \{ name: "\'ce\'e4\'ed\'ee\'f0\'e0\'e7\'ee\'e2\'ee\'e5 \'ef\'ee\'eb\'ee\'f2\'e5\'ed\'f6\'e5, \'f8\'f2", used: 2, price: 0.40 \},\par
        \{ name: "\'ce\'e4\'ed\'ee\'f0\'e0\'e7\'ee\'e2\'fb\'e9 \'ef\'e5\'ed\'fc\'fe\'e0\'f0, \'f8\'f2", used: 1, price: 0.60 \},\par
        \{ name: "\'cf\'e5\'f0\'f7\'e0\'f2\'ea\'e8, \'f8\'f2", used: 2, price: 0.15 \}\par
    ];\par
\par
    const initialTools = [\par
        \{ name: "\'cd\'ee\'e6\'ed\'e8\'f6\'fb", cost: 300, years: 5 \},\par
        \{ name: "\'d4\'e5\'ed", cost: 300, years: 3 \},\par
        \{ name: "\'d0\'e0\'f1\'f7\'e5\'f1\'ea\'e8", cost: 150, years: 2 \},\par
        \{ name: "\'d9\'e5\'f2\'ea\'e8", cost: 200, years: 2 \},\par
        \{ name: "\'c3\'ee\'f0\'ff\'f7\'e8\'e9 \'e8\'ed\'f1\'f2\'f0\'f3\'ec\'e5\'ed\'f2", cost: 500, years: 3 \},\par
        \{ name: "\'ca\'e8\'f1\'f2\'e8, \'ec\'e8\'f1\'ea\'e8", cost: 50, years: 3 \},\par
        \{ name: "\'ca\'f0\'e5\'f1\'eb\'ee \'ef\'e0\'f0\'e8\'ea\'ec\'e0\'f5\'e5\'f0\'f1\'ea\'ee\'e5", cost: 800, years: 7 \},\par
        \{ name: "\'cc\'ee\'e9\'ea\'e0 \'ef\'e0\'f0\'e8\'ea\'ec\'e0\'f5\'e5\'f0\'f1\'ea\'e0\'ff", cost: 2000, years: 7 \},\par
        \{ name: "\'d2\'e5\'eb\'e5\'e6\'ea\'e0 \'ef\'e0\'f0\'e8\'ea\'ec\'e0\'f5\'e5\'f0\'f1\'ea\'e0\'ff", cost: 350, years: 7 \},\par
        \{ name: "\'d1\'f2\'f3\'eb \'ec\'e0\'f1\'f2\'e5\'f0\'e0", cost: 250, years: 7 \}\par
    ];\par
\par
    // \'c1\'f3\'f4\'e5\'f0\'fb \'ee\'e1\'ec\'e5\'ed\'e0 \'e4\'eb\'ff \'f5\'f0\'e0\'ed\'e5\'ed\'e8\'ff \'e8\'f1\'f2\'ee\'f0\'e8\'e8 (\'ea\'ed\'ee\'ef\'ea\'e0 \'ce\'f2\'ec\'e5\'ed\'e0)\par
    let backupMaterials = [];\par
    let backupDisposables = [];\par
\par
    function initApp() \{\par
        const matBody = document.getElementById('materials-body');\par
        initialMaterials.forEach((item, idx) => \{\par
            matBody.innerHTML += `<tr><td>$\{item.name\}</td><td><input type="number" id="mat-used-$\{idx\}" value="$\{item.used\}" oninput="calculateAll()"></td><td><input type="number" id="mat-price-$\{idx\}" value="$\{item.price\}" step="0.01" oninput="calculateAll()"></td><td><input type="number" id="mat-tw-$\{idx\}" value="$\{item.totalWeight\}" oninput="calculateAll()"></td><td class="text-right" id="mat-cost-$\{idx\}">0.00</td></tr>`;\par
        \});\par
\par
        const dispBody = document.getElementById('disposables-body');\par
        initialDisposables.forEach((item, idx) => \{\par
            dispBody.innerHTML += `<tr><td>$\{item.name\}</td><td><input type="number" id="disp-used-$\{idx\}" value="$\{item.used\}" oninput="calculateAll()"></td><td><input type="number" id="disp-price-$\{idx\}" value="$\{item.price\}" step="0.01" oninput="calculateAll()"></td><td class="text-right" id="disp-cost-$\{idx\}">0.00</td></tr>`;\par
        \});\par
\par
        const amortBody = document.getElementById('amortization-body');\par
        initialTools.forEach((item, idx) => \{\par
            amortBody.innerHTML += `<tr><td>$\{item.name\}</td><td><input type="number" id="tool-cost-$\{idx\}" value="$\{item.cost\}" oninput="calculateAll()"></td><td><input type="number" id="tool-years-$\{idx\}" value="$\{item.years\}" oninput="calculateAll()"></td><td class="text-right" id="tool-amort-$\{idx\}">0.00</td></tr>`;\par
        \});\par
        calculateAll();\par
    \}\par
\par
    // \'ce\'f7\'e8\'f1\'f2\'ea\'e0 \'f2\'ee\'eb\'fc\'ea\'ee \'e2\'e2\'e5\'e4\'e5\'ed\'ed\'fb\'f5 \'ea\'ee\'eb\'e8\'f7\'e5\'f1\'f2\'e2\par
    function clearMaterialQuantities() \{\par
        backupMaterials = [];\par
        backupDisposables = [];\par
\par
        initialMaterials.forEach((_, idx) => \{\par
            const input = document.getElementById(`mat-used-$\{idx\}`);\par
            backupMaterials.push(input.value);\par
            input.value = 0;\par
        \});\par
\par
        initialDisposables.forEach((_, idx) => \{\par
            const input = document.getElementById(`disp-used-$\{idx\}`);\par
            backupDisposables.push(input.value);\par
            input.value = 0;\par
        \});\par
\par
        document.getElementById('undo-btn').disabled = false;\par
        calculateAll();\par
    \}\par
\par
    // \'c2\'ee\'f1\'f1\'f2\'e0\'ed\'ee\'e2\'eb\'e5\'ed\'e8\'e5 \'e4\'e0\'ed\'ed\'fb\'f5 \'e8\'e7 \'e1\'f3\'f4\'e5\'f0\'e0\par
    function restoreMaterials() \{\par
        if (backupMaterials.length > 0) \{\par
            initialMaterials.forEach((_, idx) => \{\par
                document.getElementById(`mat-used-$\{idx\}`).value = backupMaterials[idx];\par
            \});\par
        \}\par
        if (backupDisposables.length > 0) \{\par
            initialDisposables.forEach((_, idx) => \{\par
                document.getElementById(`disp-used-$\{idx\}`).value = backupDisposables[idx];\par
            \});\par
        \}\par
        \par
        document.getElementById('undo-btn').disabled = true;\par
        calculateAll();\par
    \}\par
\par
    function calculateAll() \{\par
        let totalSec1 = 0;\par
        initialMaterials.forEach((_, idx) => \{\par
            const used = parseFloat(document.getElementById(`mat-used-$\{idx\}`).value) || 0;\par
            const price = parseFloat(document.getElementById(`mat-price-$\{idx\}`).value) || 0;\par
            const tw = parseFloat(document.getElementById(`mat-tw-$\{idx\}`).value) || 1;\par
            const cost = (used * price) / tw;\par
            totalSec1 += cost;\par
            document.getElementById(`mat-cost-$\{idx\}`).innerText = cost.toFixed(2);\par
        \});\par
        document.getElementById('total-sec1').innerText = totalSec1.toFixed(2);\par
\par
        let totalSec2 = 0;\par
        initialDisposables.forEach((_, idx) => \{\par
            const used = parseFloat(document.getElementById(`disp-used-$\{idx\}`).value) || 0;\par
            const price = parseFloat(document.getElementById(`disp-price-$\{idx\}`).value) || 0;\par
            const cost = used * price;\par
            totalSec2 += cost;\par
            document.getElementById(`disp-cost-$\{idx\}`).innerText = cost.toFixed(2);\par
        \});\par
        document.getElementById('total-sec2').innerText = totalSec2.toFixed(2);\par
\par
        const rentMonth = parseFloat(document.getElementById('rent-month').value) || 0;\par
        const workDays = parseFloat(document.getElementById('work-days').value) || 1;\par
        const workHours = parseFloat(document.getElementById('work-hours').value) || 1;\par
        const serviceHours = parseFloat(document.getElementById('service-hours').value) || 0;\par
        const totalSec3 = (rentMonth / workDays / workHours) * serviceHours;\par
        document.getElementById('total-sec3').innerText = totalSec3.toFixed(2);\par
\par
        let totalSec4 = 0;\par
        const totalWorkingHoursInYear = workDays * workHours * 12;\par
        initialTools.forEach((_, idx) => \{\par
            const cost = parseFloat(document.getElementById(`tool-cost-$\{idx\}`).value) || 0;\par
            const years = parseFloat(document.getElementById(`tool-years-$\{idx\}`).value) || 1;\par
            const amort = (cost / years / totalWorkingHoursInYear) * serviceHours;\par
            totalSec4 += amort;\par
            document.getElementById(`tool-amort-$\{idx\}`).innerText = amort.toFixed(2);\par
        \});\par
        document.getElementById('total-sec4').innerText = totalSec4.toFixed(2);\par
\par
        const desiredIncome = parseFloat(document.getElementById('desired-income').value) || 0;\par
        const incomeDays = parseFloat(document.getElementById('income-days').value) || 1;\par
        const incomeHours = parseFloat(document.getElementById('income-hours').value) || 1;\par
        const incomeServiceHours = parseFloat(document.getElementById('income-service-hours').value) || 0;\par
        const totalSec5 = (desiredIncome / incomeDays / incomeHours) * incomeServiceHours;\par
        document.getElementById('total-sec5').innerText = totalSec5.toFixed(2);\par
\par
        const totalMinimum = totalSec1 + totalSec2 + totalSec3 + totalSec4 + totalSec5;\par
        document.getElementById('total-minimum').innerText = totalMinimum.toFixed(2) + ' BYN';\par
\par
        const customPrice = parseFloat(document.getElementById('custom-price').value) || 0;\par
        const envTax = customPrice * 0.10;\par
        const envMaterials = totalSec1 + totalSec2;\par
        const envRent = totalSec3;\par
        const envTools = totalSec4;\par
        const netProfit = customPrice - (envTax + envMaterials + envRent + envTools);\par
\par
        document.getElementById('env-tax').innerText = envTax.toFixed(2) + ' BYN';\par
        document.getElementById('env-materials').innerText = envMaterials.toFixed(2) + ' BYN';\par
        document.getElementById('env-rent').innerText = envRent.toFixed(2) + ' BYN';\par
        document.getElementById('env-tools').innerText = envTools.toFixed(2) + ' BYN';\par
        document.getElementById('net-profit').innerText = netProfit.toFixed(2) + ' BYN';\par
\par
        const sumAll = envTax + envMaterials + envRent + envTools;\par
        const chartElement = document.getElementById('distribution-chart');\par
        if(sumAll > 0) \{\par
            const pTax = (envTax / sumAll) * 100;\par
            const pMat = (envMaterials / sumAll) * 100;\par
            const pRent = (envRent / sumAll) * 100;\par
            \par
            chartElement.style.background = `conic-gradient(\par
                var(--accent-red) 0% $\{pTax\}%, \par
                var(--brand-gold) $\{pTax\}% $\{pTax + pMat\}%, \par
                var(--text-white) $\{pTax + pMat\}% $\{pTax + pMat + pRent\}%, \par
                var(--slate-gray) $\{pTax + pMat + pRent\}% 100%\par
            )`;\par
        \} else \{\par
            chartElement.style.background = `var(--bg-input)`;\par
        \}\par
    \}\par
\par
    window.onload = initApp;\par
</script>\f1\lang1033\par
}
